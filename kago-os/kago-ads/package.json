    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "packageManager": "pnpm@11.19.0"
