# 共通バックエンドの接続先（COM-02 docs/development/backend.md）
# 値は Supabase の Project Settings > API から取る。
# publishable key（sb_publishable_ で始まるもの）以外は共通ライブラリが拒否する。
# secret key / service_role key はここにも、どこにも書かない。
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# データの取得先。省略すると supabase。
# DBに繋がずに画面だけ確認したいときは mock にする（src/data/mock の固定JSONを読む）。
# NEXT_PUBLIC_INSIGHT_DATA_SOURCE=mock
