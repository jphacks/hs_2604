import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { mkdir, writeFile } from "node:fs/promises";
import { resolve } from "node:path";
import { setTimeout as delay } from "node:timers/promises";
import { chromium, type Page } from "playwright";
import { createCartBackend } from "./fixtures/cart-backend.mts";
import { id } from "./fixtures/cart-database.mts";

const fixture=await createCartBackend({accountHistory:true});
const output=resolve("../../internal/app03-evidence");await mkdir(output,{recursive:true});
const origin="http://127.0.0.1:3109";
const server=spawn(process.execPath,["node_modules/next/dist/bin/next","dev","--webpack","--hostname","127.0.0.1","--port","3109"],{
  env:{...process.env,NEXT_PUBLIC_SUPABASE_URL:fixture.url,NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:"sb_publishable_test"},windowsHide:true,stdio:["ignore","pipe","pipe"],
});
let log="";server.stdout.on("data",c=>{log+=c});server.stderr.on("data",c=>{log+=c});
let browser;let active:Page|undefined;const passed:string[]=[];const pass=(s:string)=>{passed.push(s);console.log("PASS: "+s)};
const historyLabel="購入履歴をおすすめに使う", cartLabel="かごをおすすめに使う";
try{
  for(let i=0;i<90;i++){if(server.exitCode!==null)throw Error(log);try{if((await fetch(origin+"/api/shopping")).status===401)break;}catch{}if(i===89)throw Error(log);await delay(1000);}
  browser=await chromium.launch({headless:true,executablePath:process.env.PLAYWRIGHT_EXECUTABLE_PATH??"C:/Program Files/Google/Chrome/Application/chrome.exe"});
  const a=await browser.newContext({viewport:{width:390,height:844}});const page=await a.newPage();active=page;page.setDefaultTimeout(45000);
  const errors:string[]=[];page.on("pageerror",e=>errors.push(e.message));
  const wait=(text:string,p=page)=>p.getByText(text,{exact:true}).first().waitFor();
  const ready=async(p=page)=>{await p.getByRole("switch",{name:historyLabel,exact:true}).waitFor();for(let i=0;i<100;i++){if(await p.getByRole("switch",{name:historyLabel,exact:true}).isEnabled())return;await delay(100);}throw Error("Settings remain disabled")};
  const login=async(p:Page,n=3)=>{await p.goto(origin+"/App/account");await p.getByLabel("メールアドレス").fill(`user${n}@example.test`);await p.getByLabel("パスワード",{exact:true}).fill("fixture-password");await p.getByRole("button",{name:"ログイン",exact:true}).click();await p.getByRole("button",{name:"続きから開く",exact:true}).first().click();await ready(p);};
  const input=async()=>{const r=await a.request.get(origin+"/api/recommendation-input");assert.equal(r.status(),200);return r.json()};
  const settings=async()=>{const r=await a.request.get(origin+"/api/account");assert.equal(r.status(),200);return r.json()};
  const toggle=async(label:string,p=page)=>{await p.getByRole("switch",{name:label,exact:true}).click();await wait("設定を保存しました。",p);await ready(p)};
  await page.addInitScript(()=>localStorage.setItem("kago-os-personalization",JSON.stringify({usePurchaseHistory:true,useCurrentCart:true})));
  const anon=await a.request.get(origin+"/api/account?history=1");assert.equal(anon.status(),401);assert.match(anon.headers()["cache-control"],/private, no-store/);
  await login(page);await wait("購入時ミルク");
  assert.equal(await page.getByRole("switch",{name:historyLabel,exact:true}).isChecked(),false);
  assert.equal(await page.getByRole("switch",{name:cartLabel,exact:true}).isChecked(),false);
  assert.equal((await input()).history.status,"disabled");
  pass("authenticated account uses DB default OFF and ignores legacy shared localStorage");
  assert.equal(await page.getByRole("article").count(),10);
  assert.equal(await page.getByText("別利用者の購入品",{exact:true}).count(),0);assert.equal(await page.getByText("別店舗の購入品",{exact:true}).count(),0);
  assert.equal(await page.getByText("未来の購入品",{exact:true}).count(),0);await wait("￥120 × 2点");
  await page.getByRole("button",{name:"以前の購入を表示",exact:true}).click();
  for(let i=0;i<100;i++){if(await page.getByRole("article").count()===12)break;await delay(100);}assert.equal(await page.getByRole("article").count(),12);
  pass("purchase snapshots and cursor pagination show only this user's prior store orders");
  assert.equal((await a.request.post(origin+"/api/account",{headers:{Origin:"https://foreign.test"},data:{}})).status(),403);
  assert.equal((await a.request.post(origin+"/api/account",{headers:{Origin:origin},data:{visitId:id(15),key:"usePurchaseHistory",value:true,expectedUpdatedAt:null}})).status(),409);
  pass("cross-origin writes and switched/foreign visit requests are rejected");
  await toggle(historyLabel);let r=await input();assert.equal(r.history.status,"available");assert.equal(r.history.orders.length,12);assert.equal(r.cart.status,"disabled");
  await toggle(cartLabel);r=await input();assert.equal(r.cart.items[0].quantity,2);
  pass("saved ON settings supply real history and cart to the server recommendation input");
  await toggle(historyLabel);r=await input();assert.equal(r.history.status,"disabled");assert.deepEqual(r.history.orders,[]);assert.deepEqual(r.history.summaries,[]);
  assert.equal(await page.getByRole("article").count(),12);await wait("履歴のおすすめ利用はOFFです。購入履歴はここで確認できます。");
  pass("history OFF removes recommendation input while purchase records remain visible");
  await page.reload();await ready();assert.equal(await page.getByRole("switch",{name:historyLabel,exact:true}).isChecked(),false);assert.equal(await page.getByRole("switch",{name:cartLabel,exact:true}).isChecked(),true);
  const b=await browser.newContext({viewport:{width:390,height:844}});const second=await b.newPage();await login(second);
  assert.equal(await second.getByRole("switch",{name:historyLabel,exact:true}).isChecked(),false);assert.equal(await second.getByRole("switch",{name:cartLabel,exact:true}).isChecked(),true);
  pass("settings persist after reload and in an independent browser");
  await page.getByRole("button",{name:"店舗・来店を選ぶ",exact:true}).click();await page.getByRole("button",{name:"続きから開く",exact:true}).nth(1).click();await ready();await wait("別店舗の購入品");assert.equal(await page.getByText("購入時ミルク",{exact:true}).count(),0);
  await page.getByRole("button",{name:"店舗・来店を選ぶ",exact:true}).click();await page.getByRole("button",{name:"続きから開く",exact:true}).first().click();await ready();await wait("購入時ミルク");
  pass("store switching changes history scope while account-wide settings remain saved");
  let dropped=false;
  await page.route("**/api/account",async route=>{if(!dropped&&route.request().method()==="POST"){dropped=true;await route.abort("failed")}else await route.continue()});
  await page.getByRole("switch",{name:historyLabel,exact:true}).click();await page.getByRole("button",{name:"同じ設定を再試行",exact:true}).waitFor();
  await wait("保存結果を確認できません。同じ設定を再試行するか、DBの設定を再読み込みしてください。");assert.equal((await settings()).settings.usePurchaseHistory,false);
  await page.unroute("**/api/account");await page.getByRole("button",{name:"同じ設定を再試行",exact:true}).click();await wait("設定を保存しました。");await ready();assert.equal((await settings()).settings.usePurchaseHistory,true);
  pass("failed settings write shows uncertainty and retries the same absolute value");
  let lost=false;
  await page.route("**/api/account",async route=>{if(!lost&&route.request().method()==="POST"){lost=true;await route.fetch();await route.abort("failed")}else await route.continue()});
  await page.getByRole("switch",{name:historyLabel,exact:true}).click();await wait("保存結果を確認できません。同じ設定を再試行するか、DBの設定を再読み込みしてください。");
  const stored=(await settings()).settings;assert.equal(stored.usePurchaseHistory,false);
  await page.unroute("**/api/account");await page.getByRole("button",{name:"同じ設定を再試行",exact:true}).click();await wait("設定を保存しました。");await ready();assert.equal((await settings()).settings.updatedAt,stored.updatedAt);
  pass("response lost after saving retries without changing revision or the other preference");
  const fresh=await (await b.request.get(origin+"/api/account")).json();
  const changed=await b.request.post(origin+"/api/account",{headers:{Origin:origin},data:{visitId:id(13),key:"useCurrentCart",value:false,expectedUpdatedAt:fresh.settings.updatedAt}});assert.equal(changed.status(),200);
  await page.getByRole("switch",{name:historyLabel,exact:true}).click();await wait("別の画面で設定が変更されました。最新の設定を確認して、もう一度操作してください。");await ready();
  assert.equal(await page.getByRole("switch",{name:historyLabel,exact:true}).isChecked(),false);assert.equal(await page.getByRole("switch",{name:cartLabel,exact:true}).isChecked(),false);
  pass("another browser's newer settings cannot be overwritten by a stale request");
  let historyFailed=false;
  await page.route("**/api/account?history=*",async route=>{if(!historyFailed){historyFailed=true;await route.abort("failed")}else await route.continue()});
  await page.reload();await ready();await page.getByRole("button",{name:"購入履歴を再試行",exact:true}).waitFor();assert.equal(await page.getByText("この店舗での過去の購入履歴はまだありません。",{exact:true}).count(),0);
  await page.getByRole("button",{name:"購入履歴を再試行",exact:true}).click();await wait("購入時ミルク");await page.unroute("**/api/account?history=*");
  pass("history connection failure is distinct from empty history and recovers on retry");
  await page.screenshot({path:resolve(output,"history-mobile.png"),fullPage:true});
  await page.getByRole("button",{name:"ログアウト",exact:true}).click();await wait("買い物をはじめる");
  await login(page,4);await wait("別利用者の購入品");assert.equal(await page.getByText("購入時ミルク",{exact:true}).count(),0);
  assert.equal(await page.getByRole("switch",{name:cartLabel,exact:true}).isChecked(),false);
  await page.getByRole("button",{name:"店舗・来店を選ぶ",exact:true}).click();await page.getByRole("button",{name:"続きから開く",exact:true}).nth(1).click();await ready();await wait("この店舗での過去の購入履歴はまだありません。");await toggle(historyLabel);
  assert.equal((await input()).history.status,"empty");await page.screenshot({path:resolve(output,"empty-history-mobile.png"),fullPage:true});
  pass("account switching isolates histories/settings; enabled empty history is not disabled history");
  assert.equal(errors.length,0);console.log(`${passed.length} account browser/SQL scenarios passed.`);
  await writeFile(resolve(output,"result.json"),JSON.stringify({passed},null,2));
}catch(error){if(active){await active.screenshot({path:resolve(output,"failure.png"),fullPage:true});console.log((await active.locator("body").innerText()).slice(0,2400));}throw error;}
finally{await browser?.close();server.kill();await fixture.close();}
