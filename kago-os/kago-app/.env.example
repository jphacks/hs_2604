# Supabase project > Connect. Only the modern publishable key is accepted.
# Copy to .env.local. Blank settings show setup guidance; App has no demo fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Explicit demo mode. All three dedicated fictional customer accounts are required.
# Server-only: never prefix passwords with NEXT_PUBLIC_. Leave disabled normally.
KAGO_DEMO_ENABLED=0
KAGO_DEMO_STORE_ID=
KAGO_DEMO_U1_EMAIL=misaki.sato@example.test
KAGO_DEMO_U1_PASSWORD=
KAGO_DEMO_U2_EMAIL=ken.tanaka@example.test
KAGO_DEMO_U2_PASSWORD=
KAGO_DEMO_U3_EMAIL=yui.suzuki@example.test
KAGO_DEMO_U3_PASSWORD=

# Insightの配信元（サブパスを含めずoriginのみ。Insight側は/insightでビルド）
# INSIGHT_ORIGIN=https://<insight-project>.vercel.app

# Adsの配信元（サブパスを含めずoriginのみ）
# ADS_ORIGIN=https://<ads-project>.vercel.app
