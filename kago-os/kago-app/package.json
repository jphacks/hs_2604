{
  "name": "kago-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/sync-lp.mjs && next dev",
    "build": "node scripts/sync-lp.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test:shopping": "node --experimental-strip-types --test tests/shopping.test.ts",
    "test:shopping:database": "node --experimental-strip-types --test tests/visit-database.test.mts",
    "test:shopping:check": "node --experimental-strip-types --test tests/shopping-check.test.mts",
    "test:shopping:e2e": "node tests/shopping.e2e.mjs",
    "test:cart": "node --experimental-strip-types --test tests/cart-database.test.mts",
    "test:cart:e2e": "node --experimental-strip-types tests/cart.e2e.mts",
    "test:demo-data": "node --experimental-strip-types --test tests/demo-data.test.mts",
    "generate:demo-responses": "node --experimental-strip-types scripts/generate-demo-responses.mts",
    "check:cart": "node --experimental-strip-types --env-file=.env.shopping-check.local scripts/check-cart.mts",
    "test:account": "node --experimental-strip-types --test tests/account.test.mts",
    "test:account:e2e": "node --experimental-strip-types tests/account.e2e.mts",
    "check:account": "node --experimental-strip-types --env-file=.env.shopping-check.local scripts/check-account.mts",
    "test:backend": "pnpm --filter @kago/backend test",
    "typecheck:backend": "pnpm --filter @kago/backend typecheck",
    "check:backend": "node --experimental-strip-types --env-file=.env.local scripts/check-backend.mts",
    "check:shopping": "node --experimental-strip-types --env-file=.env.shopping-check.local scripts/check-shopping.mts",
    "generate:barcodes": "node scripts/generate-barcodes.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "sync:lp": "node scripts/sync-lp.mjs",
    "test:association": "node --experimental-strip-types --test tests/association.test.ts",
    "test:offers": "node --experimental-strip-types --test tests/offers-database.test.mts tests/serendipity.test.ts",
    "test:offers:e2e": "node --experimental-strip-types tests/offers.e2e.mts",
    "test:selection": "node --experimental-strip-types --test tests/selection.test.ts tests/selection-database.test.mts tests/selection-service.test.mts",
    "test:selection:e2e": "node --experimental-strip-types tests/recommendations.e2e.mts"
  },
  "dependencies": {
    "@kago/backend": "workspace:*",
    "@zxing/browser": "^0.2.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bwip-js": "^4.11.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "1.62.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.19.0"
}
