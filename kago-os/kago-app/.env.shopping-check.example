# Copy to .env.shopping-check.local (ignored by Git). Dedicated fictional accounts.
# These values are NOT NEXT_PUBLIC_ because credentials stay in the Node process.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
KAGO_CHECK_STORE_ID=
KAGO_CHECK_CUSTOMER_A_EMAIL=
KAGO_CHECK_CUSTOMER_A_PASSWORD=
KAGO_CHECK_CUSTOMER_B_EMAIL=
KAGO_CHECK_CUSTOMER_B_PASSWORD=
# Default read-only. Both accounts need an active visit with at least one cart item.
# Set 1 ONLY for dedicated tests: ends their selected visits, starts empty visits.
KAGO_CHECK_ALLOW_VISIT_WRITE=0
